def parse_args():
    parser = argparse.ArgumentParser(prog="apptainer-compose", description="Apptainer Compose")
    parser.add_argument("-f", "--file", help="file")
    parser.add_argument("-v", "--verbose", action="store_true", help="verbose")
    parser.add_argument("--dry-run", action="store_true", help="dry run")
    parser.add_argument("-p", "--project-name", help="project name")
    parser.add_argument("--project-directory", help="project directory")
    parser.add_argument("--ansi", help="ansi color control")
    parser.add_argument("--parallel", help="max parallelism")
    parser.add_argument("--compatibility", action="store_true", help="backward compatibility mode")
    parser.add_argument("--all-resources", action="store_true", help="include all resources")
    subparsers = parser.add_subparsers(dest="COMMAND")
    up_parser = subparsers.add_parser("up", help="Start services")
    up_parser.add_argument("service_name", nargs="*", help="Service name")
    up_parser.add_argument("--pull", help="pull policy")
    up_parser.add_argument("--quiet-pull", action="store_true", help="quiet pull")
    up_parser.add_argument("--build", action="store_true", help="build before starting")
    up_parser.add_argument("--no-build", action="store_true", help="do not build")
    up_parser.add_argument("--quiet-build", action="store_true", help="quiet build")
    up_parser.add_argument("--abort-on-container-exit", action="store_true", help="stop all containers if any stopped")
    up_parser.add_argument("--abort-on-container-failure", action="store_true", help="stop all containers if any failed")
    up_parser.add_argument("--exit-code-from", help="return exit code of selected service")
    up_parser.add_argument("--no-color", action="store_true", help="monochrome output")
    up_parser.add_argument("--no-deps", action="store_true", help="do not start linked services")
    up_parser.add_argument("--no-recreate", action="store_true", help="do not recreate containers")
    up_parser.add_argument("--force-recreate", action="store_true", help="recreate containers")
    up_parser.add_argument("--always-recreate-deps", action="store_true", help="recreate dependent containers")
    up_parser.add_argument("--remove-orphans", action="store_true", help="remove containers for undefined services")
    up_parser.add_argument("-V", "--renew-anon-volumes", action="store_true", help="recreate anonymous volumes")
    up_parser.add_argument("-t", "--timeout", help="shutdown timeout in seconds")
    up_parser.add_argument("-y", "--yes", action="store_true", help="assume yes to prompts")
    subparsers.add_parser("build", help="Stop services")
    run_parser = subparsers.add_parser("run", help="Run custom command")
    run_parser.add_argument("service_name", help="Service name")
    run_parser.add_argument("run_command", nargs="*", help="Command and arguments to run")
    args = parser.parse_args()
    if args.file is None:
        args.file = "compose.yaml"
    if args.verbose:
        print(f"{args.file=}")
        print(f"{args.COMMAND=}")
    return args


def parse_compose(args):
    r = Reader(args.file)
    return recurse(r, state_root)


def execute(d_service, args):
    print(command_to_str(d_service, args), flush=True)
    if args.dry_run:
        return
    cmd_as_list = command_to_list(d_service, args)
    result = subprocess.run(cmd_as_list)
    if result.returncode != 0:
        sys.exit(result.returncode)


def main():
    args = parse_args()
    d = parse_compose(args)
    if args.COMMAND == "run":
        if args.service_name not in d["services"]:
            print(f"service {args.service_name} not found", file=sys.stderr)
            sys.exit(1)
        d_service = d["services"][args.service_name]
        if args.run_command:
            d_service["command"] = list(args.run_command)
        execute(d_service, args)
        return
    services = d["services"]
    if args.COMMAND == "up" and args.service_name:
        for name in args.service_name:
            if name not in services:
                print(f"service {name} not found", file=sys.stderr)
                sys.exit(1)
        services = {name: services[name] for name in services if name in args.service_name}
    for d_service in services.values():
        execute(d_service, args)


if __name__ == "__main__":
    main()
