class ParsingError(Exception):

    def __init__(self, message="parsing error"):
        super().__init__(message)


def get_key_value(item):
    if ":" in item:
        if item.endswith(":"):
            key = item[:-1]
            value = None
        else:
            key_value_split = item.split(": ")
            if len(key_value_split) == 1:
                key = None
                value = key_value_split[0]
            elif len(key_value_split) == 2:
                key = key_value_split[0]
                value = key_value_split[1]
            else:
                raise ParsingError()
    else:
        key = None
        value = item
    return key, value


class YamlNode:

    def __init__(self, indentation, key, value, list_item):
        self.key = key
        self.value = value
        self.is_list_item = list_item

    def __str__(self):
        return f"{self.key=}, {self.value=}, {self.is_list_item=}"

    def __repr__(self):
        return self.__str__()


class Reader:

    def __init__(self, file_path):
        self.indentation = -1
        self.indentation_previous = -2
        self.file_path = file_path
        self.gen = self.create_gen()
        self.yn = None

    def create_gen(self):
        with open(self.file_path, "r") as f:
            is_list_item = False
            for n, line in enumerate(f, start=1):
                line = line[:-1]
                if line.isspace() or line == "":
                    continue
                self.indentation = 0
                for char in line:
                    if char == " ":
                        self.indentation += 1
                    else:
                        break
                item = line[self.indentation:]
                if item.startswith("#"):
                    continue
                if item.startswith("- "):
                    item = item[2:]
                    is_list_item = True
                key, value = get_key_value(item)
                yield YamlNode(self.indentation, key, value, is_list_item)
        while True:
            yield None

    def next(self):
        self.indentation_previous = self.indentation
        self.yn = next(self.gen)


def recurse(r, func):
    d = None
    r.next()
    ind_here = r.indentation
    while r.yn is not None:
        if ind_here == r.indentation:
            d = func(r, d)
        if ind_here > r.indentation:
            return d
        if ind_here < r.indentation_previous:
            continue
        r.next()
    return d


def helper_set_up_dict(d):
    if d is None:
        d = {}
    return d


def helper_set_up_list(d):
    if d is None:
        d = []
    return d


def helper_add_dict(r, d, func, key):
    d = helper_set_up_dict(d)
    if key is None:
        key = r.yn.key
    elif key != r.yn.key:
        raise ParsingError()
    if func is None:
        d[key] = r.yn.value
    else:
        d[key] = recurse(r, func)
    return d


def helper_add_list(r, d, func):
    d = helper_set_up_list(d)
    if func is None:
        d.append(r.yn.value)
    else:
        d.append(recurse(r, func))
    return d


def extract_key(r, d, func):
    if d is None:
        d = {}
    key = r.yn.key
    d[key] = recurse(r, func)
    return d


def helper_take_value_or_recurse(r, d, func, key):
    d = helper_set_up_dict(d)
    if r.yn.value is not None:
        value = r.yn.value
    else:
        value = recurse(r, func)
    d[key] = value
    return d


def state_build(r, d):
    if r.yn.key == "context":
        return helper_add_dict(r, d, None, "context")
    elif r.yn.key == "dockerfile":
        return helper_add_dict(r, d, None, "dockerfile")
    else:
        raise ParsingError()


def state_volumes(r, d):
    return helper_add_list(r, d, None)


def state_environment(r, d):
    if r.yn.key is None:
        key, sep, value = r.yn.value.partition("=")
        if sep:
            value = value.replace("\"", "").replace("'", "")
        d = helper_set_up_list(d)
        d.append((key, value if sep else None))
        return d
    r.yn.value = r.yn.value.replace("\"", "").replace("'", "")
    return helper_add_dict(r, d, None, None)


def state_dns(r, d):
    return helper_add_list(r, d, None)


def state_labels(r, d):
    return helper_add_dict(r, d, None, None)


def state_security_opt(r, d):
    return helper_add_list(r, d, None)


def state_x_apptainer(r, d):
    if r.yn.value in ["writable-tmpfs"]:
        r.yn.value = "--" + r.yn.value
    return helper_add_list(r, d, None)


def state_service(r, d):
    if r.yn.key == "build":
        return helper_take_value_or_recurse(r, d, state_build, "build")
    elif r.yn.key == "command":
        r.yn.value = r.yn.value.replace("$$", "$")
        r.yn.value = shlex.split(r.yn.value)
        return helper_add_dict(r, d, None, "command")
    elif r.yn.key == "image":
        return helper_add_dict(r, d, None, "image")
    elif r.yn.key == "entrypoint":
        r.yn.value = r.yn.value.replace("$$", "$")
        r.yn.value = shlex.split(r.yn.value)
        return helper_add_dict(r, d, None, "entrypoint")
    elif r.yn.key == "volumes":
        return helper_add_dict(r, d, state_volumes, "volumes")
    elif r.yn.key == "environment":
        return helper_add_dict(r, d, state_environment, "environment")
    elif r.yn.key == "hostname":
        return helper_add_dict(r, d, None, "hostname")
    elif r.yn.key == "working_dir":
        return helper_add_dict(r, d, None, "working_dir")
    elif r.yn.key == "dns":
        return helper_add_dict(r, d, state_dns, "dns")
    elif r.yn.key == "labels":
        return helper_add_dict(r, d, state_labels, "labels")
    elif r.yn.key == "security_opt":
        return helper_add_dict(r, d, state_security_opt, "security_opt")
    elif r.yn.key == "read_only":
        return helper_add_dict(r, d, None, "read_only")
    elif r.yn.key == "init":
        return helper_add_dict(r, d, None, "init")
    elif r.yn.key == "x-apptainer":
        return helper_add_dict(r, d, state_x_apptainer, "x-apptainer")
    else:
        raise ParsingError()


def state_services(r, d):
    return helper_add_dict(r, d, state_service, None)


def state_root(r, d):
    if r.yn.key == "version":
        r.next()
    return helper_add_dict(r, d, state_services, "services")


def command_to_list(d_service, args):
    l = ["apptainer"]
    if args.COMMAND in ("up", "run"):
        if d_service.get("entrypoint"):
            l.append("exec")
        else:
            l.append("run")
    x_apptainer = d_service.get("x-apptainer")
    if x_apptainer:
        l += x_apptainer
    for vol in d_service.get("volumes", []):
        l += ["--bind", vol]
    environment = d_service.get("environment")
    if environment:
        if isinstance(environment, dict):
            environment = list(environment.items())
        for k, v in environment:
            if v is not None:
                l += ["--env", k + "=" + v]
    hostname = d_service.get("hostname")
    if hostname:
        l += ["--hostname", hostname]
    working_dir = d_service.get("working_dir")
    if working_dir:
        l += ["--cwd", working_dir]
    dns = d_service.get("dns")
    if dns:
        l += ["--dns", ",".join(dns)]
    security_opt = d_service.get("security_opt")
    if security_opt:
        for opt in security_opt:
            if opt == "no-new-privileges":
                l += ["--security", "no_new_privs"]
            else:
                raise ParsingError()
    read_only = d_service.get("read_only")
    if read_only == "false":
        l += ["--writable-tmpfs"]
    init = d_service.get("init")
    if init == "false":
        l += ["--no-init"]
    image = d_service.get("image")
    if image:
        l.append("docker://" + image)
    entrypoint = d_service.get("entrypoint")
    if entrypoint:
        l += entrypoint
    command = d_service.get("command")
    if command:
        l += command
    return l


def command_to_str(d_service, args):
    s = ""
    prev = None
    for e in command_to_list(d_service, args):
        if prev == "--env":
            var, val = e.split("=")
            s += f"{var}='{val}' "
        else:
            s += e + " "
        prev = e
    s = s[:-1]
    return s


